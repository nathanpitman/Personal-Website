---
import { getCollection } from 'astro:content';

const all = await getCollection('recommended');
const items = all.filter(item => !item.data.hidden);
---

{items.length > 0 && (
  <div class="sidebar-block">
    <div class="sidebar-block-header">
      <span class="sidebar-block-title">Recommended</span>
    </div>
    <ul class="sidebar-list">
      {items.map(item => (
        <li>
          <a href={item.data.url} target="_blank" rel="noopener noreferrer">{item.data.title}</a>
          <p class="who-text" style="margin: 2px 0 0;">{item.data.description}</p>
        </li>
      ))}
    </ul>
  </div>
)}
