---
import { getCollection } from 'astro:content';

interface Props {
  relatedPosts?: { slug: string; source: string }[];
}

const { relatedPosts } = Astro.props;

const allPosts = relatedPosts?.length ? await getCollection('posts') : [];
const postMap = Object.fromEntries(allPosts.map(p => [p.slug, p]));
const resolved = (relatedPosts ?? []).map(r => postMap[r.slug]).filter(Boolean);
---

{resolved.length > 0 && (
  <div class="related-posts" data-pagefind-ignore>
    <p class="related-posts-label">Related posts</p>
    <ul class="related-posts-list">
      {resolved.map(post => (
        <li><a href={`/posts/${post.slug}`}>{post.data.title}</a></li>
      ))}
    </ul>
  </div>
)}
