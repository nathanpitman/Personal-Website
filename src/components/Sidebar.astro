---
import SiteIdentity from './SiteIdentity.astro';
import SidebarPreviously from './SidebarPreviously.astro';
import SidebarRelated from './SidebarRelated.astro';
import SidebarProjects from './SidebarProjects.astro';
import SidebarRecommended from './SidebarRecommended.astro';
import SidebarElsewhere from './SidebarElsewhere.astro';
import SidebarSubscribe from './SidebarSubscribe.astro';

interface Props {
  page?: string;
  relatedPosts?: { slug: string; source: string }[];
}

const { page = '', relatedPosts } = Astro.props;
---

<aside class="sidebar" aria-label="Sidebar" data-pagefind-ignore>

  <SiteIdentity />

  {page !== 'about' && page !== 'post' && (
    <div class="sidebar-block">
      <div class="sidebar-block-header">
        <span class="sidebar-block-title">Who, what &amp; why?</span>
      </div>
      <div class="who-text">
            <p>Managing Director of the eLearning Division at The Citation Group, previously Creative &amp; Technical Director at iHasco and MD at Nine Four for over a decade before that.</p>
            <p>Lately spending spare time exploring what's possible at the intersection of modern AI and product design — and writing about it (and many other things) here. <a href="/about/">More…</a></p>
      </div>
    </div>
  )}

  {relatedPosts?.length && <SidebarRelated relatedPosts={relatedPosts} />}

  {page !== 'index' && page !== 'about' && <SidebarPreviously />}

  {page === 'index' && <SidebarProjects />}

  {page === 'index' && <SidebarRecommended />}

  <SidebarElsewhere />

  {page !== 'about' && <SidebarSubscribe />}

</aside>
