---
import SidebarElsewhere from './SidebarElsewhere.astro';
---

<aside class="sidebar" aria-label="Sidebar" data-pagefind-ignore>

  <div class="site-identity">
    <a href="/" class="site-identity-link" aria-label="Nathan Pitman – go to homepage">
      <img
        class="site-avatar"
        src="/avatar.jpg"
        alt="Nathan Pitman"
        width="56"
        height="56"
      />
      <div class="site-identity-text">
        <span class="hello">hello, my name is</span>
        <span class="name">nathan pitman.</span>
      </div>
    </a>
  </div>

  <div class="sidebar-block">
    <div class="sidebar-block-header">
      <span class="sidebar-block-title">Contact</span>
    </div>
    <p class="who-text">
      <a
        href="#"
        class="contact-email"
        data-user="hello"
        data-domain="nathanpitman.com"
      >hello [at] nathanpitman.com</a>
    </p>
    <script>
      const el = document.querySelector('.contact-email');
      if (el) {
        el.href = 'mailto:' + el.dataset.user + '@' + el.dataset.domain;
        el.textContent = el.dataset.user + '@' + el.dataset.domain;
      }
    </script>
  </div>

  <div class="sidebar-block">
    <div class="sidebar-block-header">
      <span class="sidebar-block-title">Career</span>
    </div>
    <ul class="elsewhere-about-list">
      <li>
        <span class="elsewhere-about-role">Managing Director, eLearning Division</span>
        <span class="elsewhere-about-desc">The Citation Group · 2026–present</span>
      </li>
      <li>
        <span class="elsewhere-about-role">Managing Director</span>
        <span class="elsewhere-about-desc">iHASCO eLearning (The Citation Group) · 2020–2026</span>
      </li>
      <li>
        <span class="elsewhere-about-role">Creative &amp; Technical Director</span>
        <span class="elsewhere-about-desc">iHASCO eLearning · 2015–2020</span>
      </li>
      <li>
        <span class="elsewhere-about-role">Managing Director</span>
        <span class="elsewhere-about-desc">Nine Four Ltd · 2005–2015</span>
      </li>
      <li>
        <span class="elsewhere-about-role">Head of New Media</span>
        <span class="elsewhere-about-desc">Bite CP · 2005</span>
      </li>
      <li>
        <span class="elsewhere-about-role">Studio Manager &amp; Senior New Media Developer</span>
        <span class="elsewhere-about-desc">Mirashade · 2003–2005</span>
      </li>
      <li>
        <span class="elsewhere-about-role">Freelance Technical Editor</span>
        <span class="elsewhere-about-desc">Pearson Nordic Higher Education · 2003</span>
      </li>
      <li>
        <span class="elsewhere-about-role">Creative Developer</span>
        <span class="elsewhere-about-desc">TMB Marketing &amp; Communications · 2001–2003</span>
      </li>
      <li>
        <span class="elsewhere-about-role">Web Designer</span>
        <span class="elsewhere-about-desc">ODB Design &amp; Communication / Designation · 1997–2001</span>
      </li>
      <li>
        <span class="elsewhere-about-role">Freelance 3D Artist</span>
        <span class="elsewhere-about-desc">Enigma Creative Solutions · 1997</span>
      </li>
    </ul>
  </div>

  <div class="sidebar-block">
    <div class="sidebar-block-header">
      <span class="sidebar-block-title">Education</span>
    </div>
    <ul class="elsewhere-about-list">
      <li>
        <span class="elsewhere-about-role">Berkshire College of Art &amp; Design</span>
        <span class="elsewhere-about-desc">ND &amp; HND, 3 Dimensional Design · 1994–1997</span>
      </li>
    </ul>
  </div>

  <SidebarElsewhere />

</aside>
