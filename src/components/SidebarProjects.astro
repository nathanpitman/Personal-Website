---
import { getEntry } from 'astro:content';

const entry = await getEntry('projects', 'projects');
const items = (entry?.data ?? []).filter(project => !project.hidden);
---

{items.length > 0 && (
  <div class="sidebar-block">
    <div class="sidebar-block-header">
      <span class="sidebar-block-title">Side projects</span>
    </div>
    <ul class="side-projects-list">
      {items.map(project => (
        <li>
          <a class="side-project-name" href={project.url}>{project.title}</a>
          <p class="side-project-desc">{project.description}</p>
        </li>
      ))}
    </ul>
  </div>
)}
