---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { parseSourceId } from '../utils/routing';
import { isPublished } from '../utils/published';

const posts = await getCollection('posts');
const idMap: Record<string, string> = {};

for (const post of posts) {
  if (!isPublished(post)) continue;
  const id = parseSourceId(post.data.source);
  if (!id) continue;
  idMap[id] = post.slug;
}

const idMapJson = JSON.stringify(idMap);
const slugSetJson = JSON.stringify(posts.filter(isPublished).map(p => p.slug));

// Baseline suggestions, available with no JS: most recent posts. The client
// script below swaps this for URL-derived Pagefind results when it can.
const recentPosts = posts
  .filter(isPublished)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Page not found",
  "url": Astro.url.href,
};
---

<BaseLayout
  title="Page not found — nathanpitman.com"
  description="The page you're looking for doesn't exist or may have moved."
  jsonLd={jsonLd}
  noindex
>
  <div class="page">
    <main class="main">
      <h1 class="about-heading">Page not found</h1>
      <div class="about-body">
        <p>The page you've requested doesn't exist, or may have moved. Try
          <button type="button" id="notfound-search-btn" class="link-button">searching</button>
          or <a href="/archives">browse the archives</a> to find what you're looking for.</p>
      </div>

      <div class="notfound-suggestions" data-pagefind-ignore>
        <span class="notfound-suggestions-title" id="notfound-suggestions-title">Recent posts</span>
        <ul class="sidebar-list" id="notfound-suggestions-list">
          {recentPosts.map(post => (
            <li><a href={`/posts/${post.slug}`}>{post.data.title}</a></li>
          ))}
        </ul>
      </div>
    </main>
  </div>
</BaseLayout>

<script define:vars={{ idMapJson, slugSetJson }}>
  (function () {
    const map = JSON.parse(idMapJson);

    // Handle PHP-era URLs: /blog/index.php?id=NNN
    const params = new URLSearchParams(window.location.search);
    const id = params.get('id');
    if (id && map[id]) {
      window.location.replace('/posts/' + map[id] + '/');
      return;
    }

    // Handle /journal/{id}/{slug} legacy paths
    const journalMatch = window.location.pathname.match(/^\/journal\/(\d+)\//);
    if (journalMatch && map[journalMatch[1]]) {
      window.location.replace('/posts/' + map[journalMatch[1]] + '/');
      return;
    }

    // Handle /posts/YYYY-MM-DD-{slug} where the date doesn't match the post's frontmatter date
    const dateSlugMatch = window.location.pathname.match(/^\/posts\/\d{4}-\d{2}-\d{2}-(.+?)\/?$/);
    if (dateSlugMatch) {
      const remainder = dateSlugMatch[1];
      const knownSlugs = new Set(JSON.parse(slugSetJson));
      if (knownSlugs.has(remainder)) {
        window.location.replace('/posts/' + remainder + '/');
      }
    }
  })();
</script>

<script type="module">
  // Let the inline "searching" trigger open the same modal as the header icon.
  document.getElementById('notfound-search-btn')?.addEventListener('click', () => {
    document.getElementById('search-open-btn')?.click();
  });

  // Progressive enhancement: try to turn the words in the bad URL into
  // real suggestions via the same Pagefind index the search modal uses.
  // Falls back to the recent-posts list already rendered above if this
  // finds nothing (or Pagefind isn't available).
  (async () => {
    const words = window.location.pathname
      .split(/[\/\-_]+/)
      .filter(word => word.length > 2 && !/^\d+$/.test(word));

    if (!words.length) return;

    try {
      const pagefind = await import('/pagefind/pagefind.js');
      await pagefind.init();
      const search = await pagefind.search(words.join(' '));
      const top = await Promise.all(search.results.slice(0, 5).map(r => r.data()));
      if (!top.length) return;

      document.getElementById('notfound-suggestions-title').textContent = 'You might be looking for';
      document.getElementById('notfound-suggestions-list').innerHTML =
        top.map(r => `<li><a href="${r.url}">${r.meta.title}</a></li>`).join('');
    } catch {
      // Pagefind isn't available (e.g. local dev without a build) — keep the recent-posts fallback.
    }
  })();
</script>
