---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { parseSourceId } from '../utils/routing';

const posts = await getCollection('posts');
const idMap: Record<string, string> = {};

for (const post of posts) {
  if (post.data.hidden) continue;
  const id = parseSourceId(post.data.source);
  if (!id) continue;
  idMap[id] = post.slug;
}

const idMapJson = JSON.stringify(idMap);
const slugSetJson = JSON.stringify(posts.filter(p => !p.data.hidden).map(p => p.slug));
---

<BaseLayout title="Page not found — journal" description="The page you're looking for doesn't exist or may have moved. Browse the archives or return to the home page.">
  <div class="page">
    <main class="main">
      <article class="post">
        <header class="post-header">
          <div class="post-title-line">
            <h2 class="post-title">Page not found</h2>
          </div>
        </header>
        <div class="post-body">
          <p>This page doesn't exist, or may have moved. Try the <a href="/">home page</a> or <a href="/archives">archives</a>.</p>
        </div>
      </article>
    </main>
  </div>
</BaseLayout>

<script define:vars={{ idMapJson, slugSetJson }}>
  (function () {
    const map = JSON.parse(idMapJson);

    // Handle PHP-era URLs: /blog/index.php?id=NNN
    const params = new URLSearchParams(window.location.search);
    const id = params.get('id');
    if (id && map[id]) {
      window.location.replace('/posts/' + map[id] + '/');
      return;
    }

    // Handle /journal/{id}/{slug} legacy paths
    const journalMatch = window.location.pathname.match(/^\/journal\/(\d+)\//);
    if (journalMatch && map[journalMatch[1]]) {
      window.location.replace('/posts/' + map[journalMatch[1]] + '/');
      return;
    }

    // Handle /posts/YYYY-MM-DD-{slug} where the date doesn't match the post's frontmatter date
    const dateSlugMatch = window.location.pathname.match(/^\/posts\/\d{4}-\d{2}-\d{2}-(.+?)\/?$/);
    if (dateSlugMatch) {
      const remainder = dateSlugMatch[1];
      const knownSlugs = new Set(JSON.parse(slugSetJson));
      if (knownSlugs.has(remainder)) {
        window.location.replace('/posts/' + remainder + '/');
      }
    }
  })();
</script>
