---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SidebarTags from '../../components/SidebarTags.astro';
import PostTags from '../../components/PostTags.astro';
import { getCollection } from 'astro:content';
import { slugify, displayTag } from '../../utils/slugify';
import { getDescription } from '../../utils/description';
import CommentBubble from '../../components/CommentBubble.astro';

function getPostTags(post: any): string[] {
  return post.data.tags ?? [];
}

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const tagMap = new Map<string, { name: string; slug: string }>();

  for (const post of allPosts.filter(post => !post.data.hidden)) {
    for (const tag of post.data.tags) {
      const s = slugify(tag);
      if (!tagMap.has(s)) {
        tagMap.set(s, { name: tag, slug: s });
      }
    }
  }

  return Array.from(tagMap.values()).map(({ name, slug }) => ({
    params: { tag: slug },
    props: { tagName: name, tagSlug: slug },
  }));
}

const { tagName, tagSlug } = Astro.props;

const allPosts = await getCollection('posts');
const posts = allPosts
  .filter(post => !post.data.hidden && post.data.tags.some((t: string) => slugify(t) === tagSlug))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function formatDate(date: Date): string {
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const d = date.getDate().toString().padStart(2, '0');
  const y = date.getFullYear().toString().slice(-2);
  return `${months[date.getMonth()]} ${d}. ${y}`;
}

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `Posts tagged '${displayTag(tagName)}'`,
  "url": new URL(`/tag/${tagSlug}/`, Astro.site).href,
  "description": `Browse ${posts.length} posts tagged '${displayTag(tagName)}' in Nathan Pitman's personal journal.`
};
---

<BaseLayout title={`Journal / tag: ${displayTag(tagName)} — nathanpitman.com`} activeNav="archives" bodyClass={`tag-${tagSlug}`} description={`Browse ${posts.length} posts tagged '${displayTag(tagName)}' in Nathan Pitman's personal journal.`} jsonLd={jsonLd}>
  <div class="page">

    <main class="main">

      <h1 class="tag-heading">Archives / Tag: {displayTag(tagName)}</h1>

      {posts.map((post) => {
        const slug = post.slug;
        const description = getDescription(post);
        return (
          <article class="post">
            <header class="post-header">
              <div class="post-title-line">
                <h2 class="post-title"><a href={`/posts/${slug}`}>{post.data.title}</a></h2>
                <span class="post-date-wrap">
                  <span class="post-date">{formatDate(post.data.date)}</span>
                  <CommentBubble
                    href={`/posts/${slug}/#comments`}
                    blueskyUrl={post.data.bluesky}
                    mastodonUrl={post.data.mastodon}
                  />
                </span>
              </div>
            </header>
            <div class="post-body">
              <p>{description}</p>
              <p><a class="read-more" href={`/posts/${slug}/`}>Read more &rarr;</a></p>
            </div>
            <PostTags tags={getPostTags(post)} />
          </article>
        );
      })}

    </main>

    <SidebarTags activeTag={tagSlug} />

  </div>
</BaseLayout>
