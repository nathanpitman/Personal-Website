---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import PostTags from '../components/PostTags.astro';
import { getCollection } from 'astro:content';
import { getDescription } from '../utils/description';
import CommentBubble from '../components/CommentBubble.astro';

const allPosts = await getCollection('posts');
const posts = allPosts
  .filter(post => !post.data.hidden)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 10);

function formatDate(date: Date): string {
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const d = date.getDate().toString().padStart(2, '0');
  const y = date.getFullYear().toString().slice(-2);
  return `${months[date.getMonth()]} ${d}. ${y}`;
}

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "name": "Nathan Pitman's Journal",
      "url": "https://nathanpitman.com/",
      "description": "Nathan Pitman's personal website and journal — writing about design, technology, AI, and whatever else takes his fancy since 2003."
    },
    {
      "@type": "Person",
      "@id": "https://nathanpitman.com/#person",
      "name": "Nathan Pitman",
      "url": "https://nathanpitman.com/about/",
      "jobTitle": "Managing Director",
      "worksFor": {
        "@type": "Organization",
        "name": "Citation Group"
      }
    }
  ]
};
---

<BaseLayout title="Journal / recently — nathanpitman.com" activeNav="recently" description="Nathan Pitman's personal website and journal — writing about design, technology, AI, and whatever else takes his fancy since 2003." jsonLd={jsonLd}>
  <div class="page">

    <main class="main">

      <h1 class="visually-hidden">Journal / Recently</h1>
      <h2 class="about-heading">Journal / Recently</h2>

      {posts.map((post) => {
        const slug = post.slug;
        const description = getDescription(post);
        return (
          <article class="post">
            <header class="post-header">
              <div class="post-title-line">
                <h2 class="post-title"><a href={`/posts/${slug}`}>{post.data.title}</a></h2>
                <span class="post-date-wrap">
                  <span class="post-date">{formatDate(post.data.date)}</span>
                  <CommentBubble
                    href={`/posts/${slug}/#comments`}
                    blueskyUrl={post.data.bluesky}
                    mastodonUrl={post.data.mastodon}
                  />
                </span>
              </div>
            </header>
            <div class="post-body">
              <p>{description}</p>
              <p><a class="read-more" href={`/posts/${slug}/`}>Read more &rarr;</a></p>
            </div>
            <PostTags tags={post.data.tags ?? []} />
          </article>
        );
      })}

      <nav class="pagination" aria-label="Pagination">
        <a href="/archives" class="pagination-link">View all posts in the archives &rarr;</a>
      </nav>

    </main>

    <Sidebar page="index" />

  </div>
</BaseLayout>
