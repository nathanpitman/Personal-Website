---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getCollection } from 'astro:content';
import { slugify, displayTag } from '../../utils/slugify';
import { getDescription } from '../../utils/description';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const visible = posts.filter(p => !p.data.hidden);

  const canonical = visible.map(post => ({
    params: { slug: post.slug },
    props: { post, redirectTo: null },
  }));

  const dateRedirects = visible.map(post => {
    const d = post.data.date;
    const yyyy = d.getFullYear();
    const mm = String(d.getMonth() + 1).padStart(2, '0');
    const dd = String(d.getDate()).padStart(2, '0');
    return {
      params: { slug: `${yyyy}-${mm}-${dd}-${post.slug}` },
      props: { post, redirectTo: `/posts/${post.slug}/` },
    };
  });

  return [...canonical, ...dateRedirects];
}

const { post, redirectTo } = Astro.props;
if (redirectTo) return Astro.redirect(redirectTo, 301);
const { Content } = await post.render();
const tags = post.data.tags ?? [];

const description = getDescription(post);

function formatDate(date: Date): string {
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const d = date.getDate().toString().padStart(2, '0');
  const y = date.getFullYear().toString().slice(-2);
  return `${months[date.getMonth()]} ${d}. ${y}`;
}

const githubEditUrl = `https://github.com/nathanpitman/Personal-Website/edit/main/src/content/posts/${post.id}`;

const d = post.data.date;
const yyyy = d.getFullYear().toString();
const mm = String(d.getMonth() + 1).padStart(2, '0');
const dd = String(d.getDate()).padStart(2, '0');

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "datePublished": post.data.date.toISOString(),
  "url": new URL(`/posts/${post.slug}/`, Astro.site).href,
  "author": {
    "@type": "Person",
    "@id": "https://nathanpitman.com/#person",
    "name": "Nathan Pitman"
  },
  ...(description && { "description": description }),
  ...(tags.length > 0 && { "keywords": tags.join(', ') }),
};
---

<BaseLayout title={`${post.data.title} — Journal — nathanpitman.com`} description={description} activeNav="recently" jsonLd={jsonLd}>
  <div class="page">

    <main class="main">
      <article class="post" data-pagefind-body data-pagefind-meta={`date:${yyyy}-${mm}-${dd}`}>
        <header class="post-header">
          <div class="post-title-line">
            <h1 class="post-title">{post.data.title}</h1>
            <span class="post-date">{formatDate(post.data.date)}</span>
          </div>
        </header>
        <div class="post-body">
          <Content />
        </div>
        <p class="post-tags">
          {tags.length > 0 && (
            <>
              #{tags.map((tag: string, i: number) => (
                <><a href={`/tag/${slugify(tag)}`}>{displayTag(tag)}</a>{i < tags.length - 1 ? ', ' : ''}</>
              ))}
              {' · '}
            </>
          )}
          <a href={githubEditUrl} rel="nofollow">Edit this post</a>
        </p>
        <span class="date-search-tokens">{yyyy}-{mm}-{dd} {yyyy}-{mm} {yyyy} {mm} {dd}</span>
      </article>
    </main>

    <Sidebar page="post" relatedPosts={post.data.relatedPosts} />

  </div>
</BaseLayout>
