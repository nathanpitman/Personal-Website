---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import Comments from '../../components/Comments.astro';
import PostTags from '../../components/PostTags.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import path from 'node:path';
import { getDescription } from '../../utils/description';
import { isPublished } from '../../utils/published';
import { extractFirstImagePath } from '../../utils/og-image';
import { buildAtUri } from '../../utils/bluesky';
import { parseMastodonUrl } from '../../utils/mastodon';
import CommentBubble from '../../components/CommentBubble.astro';

const postAssetImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/posts/**/*.{jpeg,jpg,png,gif,webp,avif}'
);

async function resolveOgImage(post: CollectionEntry<'posts'>): Promise<string | null> {
  const rawPath = extractFirstImagePath(post.body ?? '');
  if (!rawPath) return null;
  if (/^https?:\/\//i.test(rawPath) || rawPath.startsWith('/')) return rawPath;

  const contentDir = path.posix.dirname(path.posix.join('/src/content/posts', post.id));
  const resolved = path.posix.normalize(path.posix.join(contentDir, rawPath));
  const importer = postAssetImages[resolved];
  if (!importer) return null;

  const mod = await importer();
  const optimized = await getImage({ src: mod.default, width: 1200 });
  return optimized.src;
}

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const visible = posts.filter(isPublished);

  const canonical = visible.map(post => ({
    params: { slug: post.slug },
    props: { post, redirectTo: null },
  }));

  const dateRedirects = visible.map(post => {
    const d = post.data.date;
    const yyyy = d.getFullYear();
    const mm = String(d.getMonth() + 1).padStart(2, '0');
    const dd = String(d.getDate()).padStart(2, '0');
    return {
      params: { slug: `${yyyy}-${mm}-${dd}-${post.slug}` },
      props: { post, redirectTo: `/posts/${post.slug}` },
    };
  });

  return [...canonical, ...dateRedirects];
}

const { post, redirectTo } = Astro.props;
if (redirectTo) return Astro.redirect(redirectTo, 301);
const { Content } = await post.render();
const tags = post.data.tags ?? [];

const description = getDescription(post);
const ogImage = await resolveOgImage(post);

function formatDate(date: Date): string {
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const d = date.getDate().toString().padStart(2, '0');
  const y = date.getFullYear().toString().slice(-2);
  return `${months[date.getMonth()]} ${d}. ${y}`;
}

const githubEditUrl = `https://github.com/nathanpitman/Personal-Website/edit/main/src/content/posts/${post.id}`;

const d = post.data.date;
const yyyy = d.getFullYear().toString();
const mm = String(d.getMonth() + 1).padStart(2, '0');
const dd = String(d.getDate()).padStart(2, '0');

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "datePublished": post.data.date.toISOString(),
  "url": new URL(`/posts/${post.slug}`, Astro.site).href,
  "author": {
    "@type": "Person",
    "@id": "https://nathanpitman.com/#person",
    "name": "Nathan Pitman",
    "sameAs": [
      "https://www.linkedin.com/in/nathanpitman/",
      "https://github.com/nathanpitman",
      "https://bsky.app/profile/nathanpitman.com",
      "https://mastodon.social/@nathanpitman"
    ]
  },
  ...(description && { "description": description }),
  ...(tags.length > 0 && { "keywords": tags.join(', ') }),
  ...(ogImage && { "image": new URL(ogImage, Astro.site).href }),
};
---

<BaseLayout title={`${post.data.title} — Journal — nathanpitman.com`} description={description} jsonLd={jsonLd} image={ogImage}>
  <div class="page">

    <main class="main">
      <article class="post" data-pagefind-body data-pagefind-meta={`date:${yyyy}-${mm}-${dd}`}>
        <header class="post-header">
          <div class="post-title-line">
            <h1 class="post-title">{post.data.title}</h1>
            <span class="post-date-wrap">
              <span class="post-date">{formatDate(post.data.date)}</span>
              <CommentBubble
                href="#comments"
                blueskyUrl={post.data.bluesky}
                mastodonUrl={post.data.mastodon}
              />
            </span>
          </div>
        </header>
        <div class="post-body">
          <Content />
          <p class="tombstone">* * *</p>
        </div>
        <PostTags tags={tags}>
          <a href={githubEditUrl} target="_blank" rel="nofollow">Edit this post</a>
        </PostTags>
        <span class="date-search-tokens">{yyyy}-{mm}-{dd} {yyyy}-{mm} {yyyy} {mm} {dd}</span>
        {(post.data.bluesky || post.data.mastodon) && (
          <Comments
            blueskyUrl={post.data.bluesky}
            blueskyAtUri={post.data.bluesky ? buildAtUri(post.data.bluesky) : null}
            mastodonUrl={post.data.mastodon}
            mastodonRef={post.data.mastodon ? parseMastodonUrl(post.data.mastodon) : null}
          />
        )}
      </article>
    </main>

    <Sidebar page="post" relatedPosts={post.data.relatedPosts} />

  </div>
</BaseLayout>
